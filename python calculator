# --- Affichage du menu ---
print("=== Ma Mini Calculatrice ===")
print("Choisis une opération :")
print("1. Addition +")
print("2. Soustraction -")
print("3. Multiplication *")
print("4. Division /")

# --- L'utilisateur choisit ---
choix = input("Entre 1, 2, 3, ou 4 : ")

# --- On demande les deux nombres ---
# float() permet de mettre des nombres à virgule comme 12.5
num1 = float(input("Entre le premier nombre : "))
num2 = float(input("Entre le deuxième nombre : "))

# --- On fait le calcul selon le choix ---
if choix == '1':
    resultat = num1 + num2  # addition
    print(f"{num1} + {num2} = {resultat}")

elif choix == '2':
    resultat = num1 - num2  # soustraction
    print(f"{num1} - {num2} = {resultat}")

elif choix == '3':
    resultat = num1 * num2  # multiplication
    print(f"{num1} * {num2} = {resultat}")

elif choix == '4':
    # Pour la division, on doit vérifier si le 2e nombre n'est pas 0
    if num2 != 0:
        resultat = num1 / num2
        print(f"{num1} / {num2} = {resultat}")
    else:
        print("Erreur : On ne peut pas diviser par 0")

else:
    print("Choix invalide")  # si l'utilisateur tape 5 ou autre
